{
  "autoCompactWindow": 500000,
  "permissions": {
    "allow": [
      "Bash(npm install -g agent-desktop)",
      "Bash(apt-get install -y at-spi2-core openbox)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/graphify-cloud.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Rappel : coder seulement sur un go explicite de Timothée ; pousser seulement sur son ordre du moment.\""
          }
        ]
      }
    ]
  }
}
