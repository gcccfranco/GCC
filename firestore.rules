rules_version = '2';

// Règles de sécurité Firestore — à publier dans la console Firebase :
// https://console.firebase.google.com/project/gcclouange/firestore/rules
//
// Lot AO : ancien ∪ nouveau, compatible avec le code en ligne ; à publier à la main par Timothée.
// (« Les accès viennent de l'organigramme », docs/spec-acces-organigramme.md, « Règles : ancien ∪ nouveau ».)
// Chaque règle touchée accepte l'ancien droit (rôles du profil, cases cochées par un admin) OU le nouveau (ce que le
// serveur recopie de l'organigramme sur le profil : `dansEquipes`, `referentDe`, `sousEquipes`, `referentSous`,
// `lieuxLouange`, `lieuxRegie`, `joue`) : jamais l'un sans l'autre, pour que `main`, qui tourne en ligne dans
// l'ancien mode, garde tous ses gestes. Une dernière passe retirera l'ancien côté le jour où il disparaît (AO-F).
//
// Lot RS (« les droits de gestion viennent d'une liste Responsabilités », docs/spec-responsabilites.md) : les droits de
// gestion (plannings, Comité Orga) se lisent dans `users/{uid}.responsabilites` (`planning:<x>`, `orga`), écrite par les
// admins seuls (refusée à la création d'un profil). Touchées : isCoordination, faitDesPlannings, peutEcrirePlanning,
// créneaux de scène, peutCreerSetlistDans.
// Lot RS, RS-D : l'ancien côté est retiré (cases `coordination` et `plannings`, `remplitParRole`, `referentDe` louange /
// edd / regie, `dansEquipes` orga, droit `annonces` et sections par l'organigramme, condition Régie par colonnes) ; à publier
// APRÈS la mise en ligne du lot RS sur main.
//
// Modèle d'accès :
// - Setlists : lecture réservée aux connectés (le filtrage par service se fait côté client) ;
//   création : le créateur doit se déclarer propriétaire (ownerId = uid, figé ensuite) ;
//   modification/suppression réservées au créateur (ownerId), aux musiciens et à la
//   présidence du même service, et aux admins.
//   L'équipe d'une setlist (`editeurs`, choisie par son propriétaire ou un admin) la voit et la
//   modifie, même privée ; elle ne la supprime pas et ne change ni `editeurs`, ni
//   `rolesPartage`, ni `isPrivate`.
//   Exception : le lien de présentation (presentationUrl) peut aussi être posé par
//   la régie inscrite au planning ce jour-là — via /api/setlist/presentation
//   (Firebase Admin, qui lit le planning), jamais par le client. Aucune règle ici.
//   Historique (setlists/{id}/history) : lu par les connectés, écrit par qui peut
//   modifier la setlist, chacun sur ses propres entrées.
//   Lot AO : une setlist PUBLIQUE ne se crée que dans une catégorie ouverte à son auteur (peutCreerSetlistDans :
//   rôle de `serviceRoles`, ou lieu de Louange / groupe / classe de l'EDD de l'organigramme) ; une setlist privée
//   (copie, brouillon perso) reste libre ; un admin crée partout. Elle ne devient pas publique, ni ne change de
//   catégorie, vers une catégorie fermée à son propriétaire (« privée puis publique »).
// - Profils (users/{uid}) : chacun crée le sien à l'inscription ; une fois créé,
//   seuls les admins peuvent le modifier. Lot AO : les champs que le serveur recopie de l'organigramme
//   (sous-équipes, lieux, instruments) sont refusés à la création, comme `dansEquipes` ; `serviceRoles` reste permis
//   (l'inscription en ligne l'écrit encore).
// - Évènements (evenements/{id}, lot 6) : « pour = eglise » public, le reste
//   pour les connectés ; inscriptions lues par les connectés, écrites par le
//   serveur seulement.
//   Réunions d'équipe (« equipe:<id> », lot U6, R4) : créées par un référent de
//   l'équipe, lues (sujets, compte rendu) par ses membres — `dansEquipes` et
//   `referentDe` du profil, écrits par le serveur seul.
//   Sujets d'une réunion d'équipe (evenements/{id}/sujets, lot U6) : lus et
//   ajoutés par les personnes de la réunion ; ordre et « traité » par
//   l'organisateur et les admins ; retirés par l'auteur, l'organisateur, un admin.
// - Programmes de scène (programmes/{id}, lot 3 bis) : lus par les connectés ;
//   écrits par la coordination (admins et Comité Orga par `responsabilites` ; lot RS, RS-D). Créneaux
//   (programmes/{id}/creneaux) : tout connecté en pose un à son nom — depuis le
//   lot U1, dans une saison ouverte et pour les groupes permis (reservable()) ;
//   auteur + coordination le modifient ou le retirent.
// - Organigramme (equipes/{id}, lot 16) : lu par les connectés ; écrit par les
//   admins et par les comptes portant le droit `equipes` (lot AO : aussi les membres d'Orga, le référent de l'équipe,
//   et, pour Louange, un référent de sous-équipe). Le rattachement qui en
//   découle (users/{uid}.dansEquipes et referentDe) reste écrit par le serveur seul.
// - config/app : état des inscriptions (registrationOpen), lisible publiquement,
//   modifiable par les admins depuis la page /admin.
// - Plannings remplis dans l'app (plannings/{key}/dimanches, lot 17) : lus
//   publiquement (pages planning consultées sans compte) ; écrits par les
//   admins et par les profils dont `plannings` porte la clé du planning, ou `remplitParRole`
//   (rôle d'un groupe, recopié par le serveur, lot 2, docs/spec-organigrammes-groupes.md). Lot AO : aussi, par
//   l'organigramme, le référent Louange (les plannings du culte), le référent EDD (les trois classes), Orga (la Table) ;
//   le référent Régie ne change que les colonnes Sono, Sono Live, PPT du culte.
// - Organigrammes des groupes (groupes/{g}, lot 2) : lus par les connectés ; tenus par les admins
//   et par le président et les VP du groupe ; président, VP et plafond des VP : admins seuls.
//
// La liste des admins doit rester synchronisée avec ADMIN_EMAILS dans src/lib/access.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'tc328829@gmail.com',
        'gcccfranco@gmail.com',
        'david.code999@gmail.com'
      ];
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Lot RS (docs/spec-responsabilites.md) : la liste « Responsabilités » du profil, écrite par les admins seuls.
    // Clés fermées : `planning:<x>` (gestionnaire d'un planning) et `orga` (Comité Orga). Miroir :
    // RESPONSABILITES_PLANNING (src/lib/acces/responsabilites.ts).
    function responsabilites() {
      return profile().get('responsabilites', []);
    }

    // Gère-t-on la grille `key` (clé de GRILLES) ? Toute la grille, sans découpage par colonne (Q5). Table en dur,
    // comme RESPONSABILITES_PLANNING.
    function gerePlanning(key) {
      return hasProfile() && (
        (key == 'culte' && 'planning:culte' in responsabilites())
        || (key == 'intergroupe' && 'planning:intergroupe' in responsabilites())
        || (key == 'interfranco' && 'planning:interfranco' in responsabilites())
        || (key in ['campusMatin', 'campusSoir'] && 'planning:campus' in responsabilites())
        || (key == 'table' && 'planning:table' in responsabilites())
        || (key in ['eddZhongban', 'eddDaban', 'eddGaoban'] && 'planning:edd' in responsabilites())
        || (key == 'paix' && 'planning:paix' in responsabilites())
        || (key in ['fidelite', 'fideliteMusiciens'] && 'planning:fidelite' in responsabilites())
        || (key == 'bonte' && 'planning:bonte' in responsabilites()));
    }

    // Gère-t-on au moins un planning ?
    function gereUnPlanning() {
      return hasProfile() && responsabilites().hasAny([
        'planning:culte', 'planning:intergroupe', 'planning:interfranco', 'planning:campus', 'planning:table',
        'planning:edd', 'planning:paix', 'planning:fidelite', 'planning:bonte']);
    }

    // Cours d'Harmonie (docs/spec-cours-harmonie.md, C2 et C4) : ce que chacun a
    // fini, champ par champ. Écrit par l'intéressé seul ; lu par lui et par les
    // admins (tableau de l'équipe). Miroir client : canSeeTeamCoursProgres (access.ts).
    match /coursProgres/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Lecture par tout connecté (les règles setlists et le client lisent les profils)
      allow read: if signedIn();
      // Création (première complétion) : l'intéressé crée son propre profil sans
      // s'attribuer de droits d'annonces ni de notifications ; les admins peuvent
      // créer n'importe quel profil.
      allow create: if signedIn() && (
        isAdmin()
        || (request.auth.uid == uid
            // La création d'un profil suit l'ouverture des inscriptions (config/app.registrationOpen ;
            // absent = ouvert, comme getRegistrationOpen dans src/lib/firebase/users.ts).
            && (!exists(/databases/$(database)/documents/config/app)
                || get(/databases/$(database)/documents/config/app).data.get('registrationOpen', true) != false)
            // L'adresse du profil est celle du compte (Firebase Auth peut normaliser la casse).
            && request.resource.data.get('email', '').lower() == request.auth.token.email.lower()
            && request.resource.data.get('annonces', []) == []
            && request.resource.data.get('notify', []) == []
            && request.resource.data.get('coordination', false) == false
            && request.resource.data.get('equipes', false) == false
            && request.resource.data.get('plannings', []) == []
            && request.resource.data.get('dansEquipes', []) == []
            && request.resource.data.get('referentDe', []) == []
            // Lot 2 (organigrammes des groupes) : groupe et droits par rôle, recopiés par le serveur seul.
            && request.resource.data.get('groupe', null) == null
            && request.resource.data.get('remplitParRole', []) == []
            && request.resource.data.get('publieParRole', []) == []
            && request.resource.data.get('notifieParRole', []) == []
            // Lot AO : sous-équipes, lieux et instruments de l'organigramme, recopiés par le serveur seul.
            // `serviceRoles` refusé aussi (27/10/2026) : sans l'interrupteur du back-office, l'inscription ne
            // l'écrit plus. À publier seulement APRÈS la mise en ligne de `main` sans interrupteur : l'ancienne
            // inscription (BACK_OFFICE coupé) l'écrit encore et serait refusée.
            && request.resource.data.get('serviceRoles', {}) == {}
            && request.resource.data.get('sousEquipes', []) == []
            && request.resource.data.get('referentSous', []) == []
            && request.resource.data.get('lieuxLouange', []) == []
            && request.resource.data.get('lieuxRegie', []) == []
            && request.resource.data.get('joue', []) == []
            // Lot RS : les responsabilités ne s'attribuent que par un admin (l'intéressé ne s'en donne pas).
            && request.resource.data.get('responsabilites', []) == [])
      );
      // Une fois le profil créé, seuls les admins peuvent le modifier (Lot RS : donc seuls eux écrivent
      // `responsabilites`).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Congés et absences (SC3, docs/spec-createur-corbeille-absences.md ; Q8, Q9) : chacun écrit et lit
    // les siennes ; ceux qui font les plannings (admins, ou `plannings` non vide) en saisissent pour
    // quelqu'un et lisent celles de tous. Le motif n'est masqué que côté navigateur (canVoirMotifAbsence).
    // Miroir client : faitDesPlannings, canSaisirAbsence (src/lib/access.ts). Règle à publier à la main.
    // Lot RS, RS-D : les admins, et qui gère au moins un planning (`planning:<x>` dans `responsabilites`) ; l'ancien
    // côté (`plannings`, `remplitParRole`, référents, Orga) est retiré.
    function faitDesPlannings() {
      return isAdmin() || gereUnPlanning();
    }

    function absenceValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['du', 'au', 'motif'])
        && d.get('du', null) is string && d.get('au', null) is string
        && d.du.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.au.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.du <= d.au
        && (!('motif' in d) || (d.motif is string && d.motif.size() <= 200));
    }

    match /users/{uid}/absences/{id} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || faitDesPlannings());
      allow create, update: if signedIn() && (request.auth.uid == uid || faitDesPlannings()) && absenceValide();
    }

    // Lecture de toutes les absences d'un coup (collection group) : qui fait les plannings.
    match /{chemin=**}/absences/{id} {
      allow read: if signedIn() && faitDesPlannings();
    }

    match /annonces/{id} {
      allow read: if signedIn();
      // Publication : admins + membres dont le profil liste la section dans `annonces`
      allow create: if signedIn() && (
        isAdmin()
        || (hasProfile()
            && request.resource.data.section in profile().get('annonces', [])
            && request.resource.data.authorId == request.auth.uid)
      );
      // Modification/suppression : auteur + admins
      allow update, delete: if signedIn() && (
        isAdmin() || resource.data.authorId == request.auth.uid
      );
    }

    // Organigramme (lot 16, docs/spec-organigramme.md). Lu par tout membre
    // connecté (l'écran est nominatif : rien sans compte) ; écrit par les admins
    // et par les comptes à qui un admin a donné le droit `equipes` sur leur
    // profil (D4, rouverte par Timothée le 18/09/2026 : « pouvoir donner la
    // possibilité à certains de modifier tout l'organigramme »).
    // `users/{uid}.dansEquipes` n'est PAS ouvert pour autant : placer quelqu'un dans
    // une équipe passe par /api/equipes/rattachement (Admin SDK, qui revérifie ce même
    // droit) — `allow update` sur users/{uid} reste aux admins.
    // Miroir client : canVoirEquipes / canEditerEquipes (src/lib/access.ts).
    // Lot AO : ancien ∪ nouveau — aussi les membres d'Orga (« coordination générale », `dansEquipes` recopié par le serveur).
    function isEquipier() {
      return isAdmin() || (hasProfile() && (profile().get('equipes', false) == true
                                            || 'orga' in profile().get('dansEquipes', [])));
    }

    // Lot AO : le référent d'une équipe tient son équipe (`referentDe` ∋ id) ; pour Louange, un référent de
    // sous-équipe (`referentSous` non vide) écrit aussi le document. Choix de confiance du projet : la règle ne voit
    // pas QUELLE ligne change — la limite « sa sous-équipe seulement » est côté navigateur (peutPlacerMembre,
    // src/lib/access.ts), comme le reste du filtrage du site.
    function peutEcrireEquipe(id) {
      return hasProfile() && (id in profile().get('referentDe', [])
                              || (id == 'louange' && profile().get('referentSous', []).size() > 0));
    }

    match /equipes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isEquipier() || peutEcrireEquipe(id));
    }

    // Équipes (lot 1 du chantier « équipes et groupes », docs/spec-equipes-sans-poles.md) : est d'une
    // équipe qui y figure (`dansEquipes`, recopié par le serveur) ; « louange » aussi à toute personne
    // qui a un rôle de service, une clé de `serviceRoles` suffit (décisions 5 et 42), ou un groupe
    // (champ `groupe` non vide, recopié par le serveur, lot 2, OG38). En est référent
    // qui y est référent (`referentDe`, recopié par le serveur). Les admins sont des deux partout.
    // Miroir : estDeLEquipe / estReferentDe (src/lib/access.ts).
    function estDeLEquipe(equipe) {
      return isAdmin() || (hasProfile() && (
        equipe in profile().get('dansEquipes', [])
        || (equipe == 'louange' && (profile().get('serviceRoles', {}).size() > 0
                                    || profile().get('groupe', '') != ''))));
    }
    function estReferentDe(equipe) {
      return isAdmin() || (hasProfile() && equipe in profile().get('referentDe', []));
    }

    // Organigrammes des groupes (lot 2, docs/spec-organigrammes-groupes.md). Lus par tout connecté (décision 16) ;
    // tenus par les admins et par le président et les VP du groupe : leur `referentDe` porte « comite-<g> »,
    // recopié par le serveur seul (patron D9 de docs/spec-organigramme.md, lot 16). Président, VP et plafond des VP
    // (maxVp, 2 si absent) : admins seuls (décisions 11 et 36). Miroir client : canTenirGroupe, placesVp ;
    // serveur : exigerTenirGroupe.
    function tientGroupe(g) {
      return isAdmin() || (hasProfile() && ('comite-' + g) in profile().get('referentDe', []));
    }

    // Plafond des VP du document écrit : maxVp absent (= 2) ou entier de 1 à 9, et pas plus de VP que lui.
    function vpDansLePlafond() {
      let max = request.resource.data.get('maxVp', 2);
      return max is int && max >= 1 && max <= 9
        && request.resource.data.get('vp', []).size() <= max;
    }

    match /groupes/{g} {
      allow read: if signedIn();
      allow create: if isAdmin() && g in ['paix', 'fidelite', 'bonte', 'amour', 'joie'] && vpDansLePlafond();
      allow update: if signedIn() && tientGroupe(g) && vpDansLePlafond()
        && (isAdmin()
            || (request.resource.data.get('president', null) == resource.data.get('president', null)
                && request.resource.data.get('vp', []) == resource.data.get('vp', [])
                && request.resource.data.get('maxVp', null) == resource.data.get('maxVp', null)));
      allow delete: if false;
    }

    // Programmes de scène (lot 3 bis, docs/spec-programme-scene.md). Miroir :
    // isCoordination / canEditCreneau dans src/lib/access.ts. La coordination est
    // le droit `coordination` du profil, coché par un admin (lot 1 du chantier
    // « équipes et groupes », docs/spec-equipes-sans-poles.md, EQ24) : aucune équipe
    // ne la donne.
    // Lot RS, RS-D : les admins et le Comité Orga (`orga` dans `responsabilites`, Q11) ; la case `coordination`, les
    // référents Louange / EDD et les membres d'Orga (champs recopiés) ne comptent plus.
    function isCoordination() {
      return isAdmin() || (hasProfile() && 'orga' in responsabilites());
    }

    // Tâches par équipe (lot 7, docs/spec-taches.md ; lot 1 du chantier « équipes et groupes »,
    // docs/spec-equipes-sans-poles.md, EQ6 à EQ8, décisions 2, 3 et 41). L'équipe se lit dans le
    // chemin. Ses membres (Louange élargi) voient ; ses référents et les admins créent, modifient,
    // suppriment. Cocher : le responsable s'il est de l'équipe ; une tâche sans responsable
    // (« toute l'équipe »), les référents et les admins. Les règles de equipes/{id} ne s'étendent pas
    // à cette sous-collection. Miroir : estDeLEquipe, equipesOuCreer, peutCocher (src/lib/access.ts).
    match /equipes/{equipe}/taches/{id} {
      allow read: if signedIn() && estDeLEquipe(equipe);
      allow create: if signedIn() && estReferentDe(equipe)
        && request.resource.data.auteurUid == request.auth.uid
        && request.resource.data.equipe == equipe;
      allow update: if signedIn() && estReferentDe(equipe) && request.resource.data.equipe == equipe;
      allow delete: if signedIn() && estReferentDe(equipe);

      // `get('responsableUid', null)` : une tâche sans le champ se lit « toute l'équipe ».
      match /fois/{date} {
        allow read: if signedIn() && estDeLEquipe(equipe);
        allow write: if signedIn() && (estReferentDe(equipe)
          || (estDeLEquipe(equipe)
              && get(/databases/$(database)/documents/equipes/$(equipe)/taches/$(id)).data.get('responsableUid', null)
                 == request.auth.uid));
      }
    }

    match /programmes/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isCoordination();

      // U1 (docs/spec-scene-saison.md) : un membre réserve dans une saison ouverte,
      // pour des groupes permis par « Qui peut réserver » (liste vide = tout membre
      // connecté) ; la coordination n'est pas limitée. Un get() par écriture.
      // Miroir : canReserverPour (src/lib/access.ts).
      // Lot RS : ancien ∪ nouveau — les gestionnaires de planning réservent toujours, sans les limites de saison ni
      // de groupes, comme la coordination (Q12) ; la modification de l'auteur suit la même règle.
      // Une édition fermée à la main (`fermees`, docs/spec-fermer-reservations.md, FR10) refuse création et modification ; la suppression reste permise.
      function reservable(programmeId, qui) {
        let p = get(/databases/$(database)/documents/programmes/$(programmeId)).data;
        return p.get('ouvert', true) == true
          && p.get('fermees', false) != true
          && (p.get('quiAutorises', []).size() == 0 || qui.hasOnly(p.quiAutorises));
      }

      match /creneaux/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.auteurUid == request.auth.uid
          && (isCoordination() || gereUnPlanning() || reservable(id, request.resource.data.qui));
        allow update: if signedIn() && (isCoordination()
          || (resource.data.auteurUid == request.auth.uid
              && (gereUnPlanning() || reservable(id, request.resource.data.qui))));
        allow delete: if signedIn() && (isCoordination() || resource.data.auteurUid == request.auth.uid);
      }
    }

    // Réunions d'équipe (lot U6, docs/spec-back-office.md ; lot 1 du chantier
    // « équipes et groupes », EQ22) : est de la réunion le membre de l'équipe
    // (estDeLEquipe : `dansEquipes`, et le public Louange élargi), l'organisateur,
    // un admin ; seuls l'organisateur et les admins l'« organisent » (ordre des
    // sujets, « traité »). Miroir : estDeLaReunion, peutOrdonnerSujets (access.ts).
    function reunion(id) { return get(/databases/$(database)/documents/evenements/$(id)).data; }
    function organise(id) { return isAdmin() || reunion(id).organisateurUid == request.auth.uid; }
    function changeSeulement(champs) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs); }
    function estDeLaReunion(e) {
      return isAdmin() || e.organisateurUid == request.auth.uid
        || (e.pour.matches('equipe:[a-z0-9-]+') && estDeLEquipe(e.pour.split(':')[1]));
    }

    // Évènements (lot 6, docs/spec-evenements.md). « pour = eglise » : lisible par
    // tout le monde (calendrier public ; la requête filtre sur pour) ; les autres
    // par les connectés. Création : coordination (lot RS, RS-D : plus le
    // droit d'annonces ni l'organigramme), à son nom, compteur à zéro.
    // Modification et suppression : organisateur + coordination, sans toucher
    // au compteur. Le compteur `inscrits` et les inscriptions ne s'écrivent
    // que par le serveur (Admin SDK, /api/evenements/*). Miroir : canSeeEvenement,
    // canCreateEvenement, canEditEvenement (src/lib/access.ts).
    // Public d'un évènement qu'on peut créer : réunion d'une équipe dont on est référent, ou église et
    // sections pour la coordination. Lot RS, RS-D : le droit `annonces` et les sections par l'organigramme sont retirés.
    function pourCreable(pour) {
      return (pour.matches('equipe:[a-z0-9-]+') && estReferentDe(pour.split(':')[1]))
        || (!pour.matches('(pole|equipe):.*') && isCoordination());
    }

    match /evenements/{id} {
      allow read: if resource.data.pour == 'eglise' || signedIn();
      // Réunion ou évènement d'équipe (lot U6, R4 ; décisions 3 et 43) :
      // « equipe:<id> », créé par un référent de l'équipe (`referentDe` du profil,
      // recopié par le serveur) ou un admin. Un public hors `equipe:` n'existe plus (EQ19) :
      // la garde plus bas empêche d'en créer un. La coordination ne
      // crée que pour l'église et les sections (relecture du lot U6 : miroir exact
      // de canCreateEvenement).
      allow create: if signedIn()
        && request.resource.data.organisateurUid == request.auth.uid
        && request.resource.data.inscrits == 0
        && pourCreable(request.resource.data.pour);
      // Compte rendu d'une réunion (lot U6, R3) : toute personne de la réunion
      // colle (à son nom, un lien https://) ou retire le lien, et ne change que
      // lui. Miroir : estDeLaReunion et lienCompteRendu (src/lib/access.ts,
      // src/lib/reunions/compteRendu.ts).
      allow update: if signedIn()
        && ((request.resource.data.inscrits == resource.data.inscrits
             && request.resource.data.organisateurUid == resource.data.organisateurUid
             && (request.resource.data.pour == resource.data.pour || pourCreable(request.resource.data.pour))
             && (isCoordination() || resource.data.organisateurUid == request.auth.uid))
          || (estDeLaReunion(resource.data) && changeSeulement(['compteRendu'])
             && (request.resource.data.compteRendu == null
                 || (request.resource.data.compteRendu.parUid == request.auth.uid
                     && request.resource.data.compteRendu.url.matches('https://.+')))));
      allow delete: if signedIn() && (isCoordination() || resource.data.organisateurUid == request.auth.uid);

      match /inscriptions/{iid} {
        // Tout membre connecté voit qui est inscrit (17/09/2026) ; sans compte,
        // le compteur `inscrits` de l'évènement seulement. Miroir : canSeeInscrits
        // (src/lib/access.ts).
        allow read: if signedIn();
        allow write: if false;
      }

      // « Sujets à aborder » (lot U6, R1) : lus et ajoutés par les personnes de
      // la réunion, chacun à son nom, jamais déjà traités ni repris ; la borne
      // « jusqu'au début » se vérifie dans le navigateur (les règles ne lisent
      // pas une heure de Paris en texte, Q7). L'organisateur et les admins
      // changent l'ordre et « traité » ; une personne de la réunion marque un
      // sujet repris dans la suivante (R2), une seule fois, et seulement dans une
      // réunion qui existe, de la même équipe. Retrait : l'auteur,
      // l'organisateur, un admin. Miroir : peutAjouterSujet, peutRetirerSujet,
      // peutOrdonnerSujets (src/lib/access.ts).
      match /sujets/{sid} {
        allow read: if signedIn() && estDeLaReunion(reunion(id));
        allow create: if signedIn() && estDeLaReunion(reunion(id)) && request.resource.data.auteurUid == request.auth.uid
          && request.resource.data.traite == false && request.resource.data.reprisDans == null;
        allow update: if signedIn() && ((organise(id) && changeSeulement(['ordre', 'traite']))
          || (estDeLaReunion(reunion(id)) && resource.data.reprisDans == null && changeSeulement(['reprisDans'])
              && reunion(request.resource.data.reprisDans).pour == reunion(id).pour));
        allow delete: if signedIn() && (organise(id) || resource.data.auteurUid == request.auth.uid);
      }
    }

    // Propositions de chants envoyées par les membres (inbox de modération /admin).
    match /songProposals/{id} {
      // Lecture réservée aux admins.
      allow read: if isAdmin();
      // Tout membre connecté peut proposer ; il se déclare auteur, statut « pending ».
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Tri / suppression réservés aux admins.
      allow update, delete: if isAdmin();
    }

    // Signalements (problèmes chant / site) envoyés par les membres connectés.
    // Écriture côté serveur uniquement (Admin SDK, /api/report) afin de notifier
    // les admins dans la foulée → création client interdite.
    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Questionnaire de satisfaction (page /questionnaire) : un document par membre,
    // dont l'id est son uid → une seule réponse par personne, qu'il peut relire et
    // modifier. Dépouillement (liste complète) et suppression réservés aux admins.
    match /surveyResponses/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }

    match /setlists/{id} {
      allow read: if signedIn();
      // Création : le créateur doit se déclarer propriétaire (ownerId = uid)
      allow create: if signedIn()
        && request.resource.data.get('ownerId', null) == request.auth.uid
        // Une setlist de fête naît de /api/fetes/saisir (Admin SDK), jamais d'un navigateur
        // (docs/spec-chants-fetes.md, « Droits en double »).
        && !('fete' in request.resource.data)
        && !(request.resource.data.get('category', '') in ['Noël', 'Pâques'])
        // Lot AO : une setlist publique se crée dans une catégorie ouverte à son auteur ; une privée (copie, brouillon
        // perso) et un admin : libres. Miroir : creatableCategories (src/lib/access.ts).
        && (
          request.resource.data.get('isPrivate', false) == true
          || isAdmin()
          || peutCreerSetlistDans(request.resource.data.get('category', ''))
        );
      // Modification : ownerId ne change jamais ; qui peut modifier =
      // canEditSetlistDoc (le propriétaire, son équipe ; sur une setlist non
      // privée, un admin — SC1, docs/spec-createur-corbeille-absences.md).
      // Seuls le propriétaire et les admins changent la catégorie ; l'équipe
      // (`editeurs`) ne la déplace pas (PS8).
      allow update: if signedIn()
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
        && canEditSetlistDoc(resource.data)
        && (
          resource.data.get('ownerId', '') == request.auth.uid
          || isAdmin()
          || request.resource.data.category == resource.data.category
        )
        // Lot AO : le document résultant, s'il est public, change de catégorie ou de visibilité vers une catégorie
        // ouverte à l'auteur seulement — le propriétaire ne contourne pas la création par « privée puis publique ».
        && (
          request.resource.data.get('isPrivate', false) == true
          || isAdmin()
          || (request.resource.data.get('category', '') == resource.data.get('category', '')
              && request.resource.data.get('isPrivate', false) == resource.data.get('isPrivate', false))
          || peutCreerSetlistDans(request.resource.data.get('category', ''))
        )
        // L'équipe : seuls le propriétaire et les admins la changent.
        && (
          resource.data.get('ownerId', '') == request.auth.uid
          || isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editeurs', 'rolesPartage'])
        )
        // La visibilité : pas l'équipe.
        && (
          canDeleteSetlistDoc(resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPrivate'])
        )
        // Fête (docs/spec-chants-fetes.md) : `fete` n'est jamais posé ni retiré depuis un navigateur ;
        // aucune setlist n'entre dans la catégorie Noël ou Pâques ; une setlist de fête garde sa
        // catégorie, son équipe (`editeurs`, `rolesPartage`, écrits par le serveur seul, même pas par
        // un admin ou la coordination) et reste publique.
        && request.resource.data.get('fete', null) == resource.data.get('fete', null)
        && (
          !(request.resource.data.get('category', '') in ['Noël', 'Pâques'])
          || request.resource.data.get('category', '') == resource.data.get('category', '')
        )
        && (
          resource.data.get('fete', null) == null
          || (
            request.resource.data.get('category', '') == resource.data.get('category', '')
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editeurs', 'rolesPartage'])
            && request.resource.data.get('isPrivate', false) == false
          )
        )
        // Corbeille (SC2, docs/spec-createur-corbeille-absences.md) : mettre une setlist à la corbeille
        // ou l'en sortir = le droit de la supprimer ; `supprimeePar` est toujours soi-même.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['supprimeeLe', 'supprimeePar'])
          || (canDeleteSetlistDoc(resource.data)
              && request.resource.data.get('supprimeePar', request.auth.uid) == request.auth.uid)
        );
      // Suppression : le droit de modification d'avant le partage — pas l'équipe.
      allow delete: if signedIn() && canDeleteSetlistDoc(resource.data);

      // Historique des modifications (docs/spec-setlist.md) : lu par tout
      // connecté, comme la setlist ; écrit par qui peut la modifier
      // (canEditSetlistDoc), sous son propre nom et sur ses propres entrées.
      match /history/{entryId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && canEditSetlistDoc(get(/databases/$(database)/documents/setlists/$(id)).data);
        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid
          && canEditSetlistDoc(get(/databases/$(database)/documents/setlists/$(id)).data);
      }

      // Versions perso d'un chant (docs/spec-version-perso.md) : un document
      // par personne, lu par tout connecté (versions partagées), écrit par
      // son propriétaire seul. Miroir client : canHaveSetlistVersion
      // (src/lib/access.ts) = qui voit la setlist.
      match /versions/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.authorUid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Lot AO : où l'on crée une setlist publique, ancien ∪ nouveau. Ancien (miroir de categoryLevel ≥ create) : la
    // clé de `serviceRoles` avec un rôle chanteur / musicien / présidence, ou, pour un groupe (Paix, Fidélité,
    // Bonté) ou une classe de l'EDD, la seule présence de la clé. Nouveau (miroir de categoriesCreables,
    // src/lib/acces/organigramme.ts) : membre de Louange et la catégorie est dans `lieuxLouange` ; la catégorie du
    // `groupe` (id « paix », « fidelite », « bonte ») ; membre d'`edd` et une des trois classes. La Régie (lieuxRegie)
    // n'y crée pas : lecture seule.
    // Lot RS : ancien ∪ nouveau — le gestionnaire d'un planning crée dans les catégories de son service (miroir de
    // categoriesDesPlannings, src/lib/acces/responsabilites.ts).
    function peutCreerSetlistDans(category) {
      return hasProfile() && (
        profile().get('serviceRoles', {}).get(category, []).hasAny(['chanteur', 'musicien', 'presidence'])
        || (category in ['Groupe Paix', 'Groupe Fidélité', 'Groupe Bonté', '中班', '大班', '高班']
            && category in profile().get('serviceRoles', {}))
        || ('louange' in profile().get('dansEquipes', []) && category in profile().get('lieuxLouange', []))
        || (category == 'Groupe Paix' && profile().get('groupe', '') == 'paix')
        || (category == 'Groupe Fidélité' && profile().get('groupe', '') == 'fidelite')
        || (category == 'Groupe Bonté' && profile().get('groupe', '') == 'bonte')
        || ('edd' in profile().get('dansEquipes', []) && category in ['中班', '大班', '高班'])
        || (category == 'Culte Francophone' && 'planning:culte' in responsabilites())
        || (category == 'Intergroupe' && 'planning:intergroupe' in responsabilites())
        || (category == 'Interfranco' && 'planning:interfranco' in responsabilites())
        || (category == 'Campus' && 'planning:campus' in responsabilites())
        || (category in ['中班', '大班', '高班'] && 'planning:edd' in responsabilites())
        || (category == 'Groupe Paix' && 'planning:paix' in responsabilites())
        || (category == 'Groupe Fidélité' && 'planning:fidelite' in responsabilites())
        || (category == 'Groupe Bonté' && 'planning:bonte' in responsabilites()));
    }

    // Miroir de canDeleteSetlist (src/lib/access.ts) : une setlist privée ne se
    // supprime que par son propriétaire.
    function canDeleteSetlistDoc(setlist) {
      // Le créateur seul (docs/spec-createur-corbeille-absences.md, SC1) ; les admins sur une
      // setlist non privée (Q1) ; le niveau « edit » de la catégorie n'y donne plus droit.
      return setlist.get('ownerId', '') == request.auth.uid
        || (!setlist.get('isPrivate', false) && isAdmin())
        // Setlist de fête : la coordination (docs/spec-chants-fetes.md).
        || (setlist.get('fete', null) != null && isCoordination());
    }

    // Miroir de canEditSetlist (src/lib/access.ts) : une setlist privée ne se
    // modifie que par son propriétaire et son équipe.
    function canEditSetlistDoc(setlist) {
      return canDeleteSetlistDoc(setlist)
        || request.auth.uid in setlist.get('editeurs', []);
    }

    // Harmonie (lot 9, docs/spec-harmonie.md). Le catalogue lui-même est un
    // fichier public (public/harmonie-index.json) : rien ici. Restent ce que
    // l'équipe écrit autour d'un chant, lisible de tout membre connecté (le
    // filtrage pianiste / guitariste est côté navigateur, comme le reste du
    // site — choix de confiance assumé).
    match /harmonie/{songSlug} {
      allow read: if signedIn();
      // Le document parent n'est jamais écrit : seules les sous-collections le sont.
      allow write: if false;

      // Une idée automatique qui ne marche pas sur ce chant : elle disparaît
      // pour tout le monde. Son auteur ou un admin peut la remettre.
      match /rejets/{rid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        // Réécrire le même refus (double tap, état local en retard) ne doit pas
        // échouer ; changer son auteur, si.
        allow update: if signedIn() && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }

      // Idées de l'équipe, attachées au chant. Modifiables par leur auteur ;
      // les admins peuvent supprimer.
      match /idees/{iid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // Annotations dessinées en Mode Louange (personnelles).
    // L'id du document est préfixé par l'uid du propriétaire :
    // {uid}__{setlistId}__{pageKey} — voir src/lib/firebase/annotations.ts.
    match /annotations/{id} {
      allow read, write: if signedIn() && id.split('__')[0] == request.auth.uid;
    }

    // Abonnements push (un document par appareil).
    // L'id est préfixé par l'uid du propriétaire : {uid}__{hashEndpoint}
    // — voir src/lib/push/client.ts. Chacun ne gère que ses propres appareils ;
    // le serveur (Firebase Admin) lit tous les abonnements pour envoyer.
    match /pushSubscriptions/{id} {
      allow read, write: if signedIn() && id.split('__')[0] == request.auth.uid;
    }

    // Journal des notifications envoyées (idempotence des rappels + anti-spam
    // setlist/annonce). Écrit/lu uniquement par le serveur via Firebase Admin, qui
    // contourne ces règles — interdit à tout client.
    match /notifLog/{id} {
      allow read, write: if false;
    }

    // Notifications « cloche » : une entrée par push ponctuel (manuel, rappel,
    // diffusion), générée côté serveur (Admin SDK). Lecture par tout membre
    // connecté — le ciblage par destinataire (champ `recipients` / `everyone`)
    // est appliqué côté client (cf. useNotifications), cohérent avec le modèle de
    // confidentialité assumé du projet. Écriture réservée au serveur.
    match /notifications/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Préférences de notification par type (un doc par membre, id = uid) : chacun
    // gère les siennes ; le serveur (Admin) les lit pour filtrer les envois auto.
    match /notifPrefs/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Accueil de première connexion déjà vu (lot 8, docs/spec-nouveaux-membres.md) :
    // doc auto-géré par l'intéressé (le profil users/{uid} est verrouillé).
    // Miroir : src/lib/firebase/onboarding.ts (aucun droit dans access.ts, chacun
    // n'écrit que le sien).
    match /onboarding/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Back-Office de chacun (lot U6, B5, docs/spec-back-office.md, Q5) : disposition du
    // tableau de bord et barre du bas, écrites par l'intéressé seul (le profil users/{uid}
    // est verrouillé). Miroir : src/lib/firebase/backOffice.ts (aucun droit dans access.ts,
    // chacun n'écrit que le sien ; `widgetsPermis` filtre l'affichage).
    match /backOffice/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }

    match /config/app {
      // La page d'inscription lit registrationOpen sans être connectée
      allow read: if true;
      allow write: if isAdmin();
    }

    // Publication des plannings par trimestre : un doc par planning+année
    // (planningReleases/{key}_{year}, champ published[]). Lisible publiquement —
    // les pages planning, consultées sans compte, masquent les trimestres non
    // publiés. Écriture réservée au serveur (Admin SDK, /api/planning/release),
    // qui vérifie les droits de publication → interdite à tout client.
    match /planningReleases/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Planning rempli dans l'app (lot 17, docs/spec-planning-grille.md). Un
    // document par dimanche, une case par champ : une écriture ne porte que sur
    // sa colonne (updateMask), donc deux personnes ne s'effacent jamais.
    // Lecture PUBLIQUE, comme planningReleases : les pages planning se
    // consultent sans compte, et le CSV gviz du Google Sheet l'est déjà.
    // Écriture : les admins, et qui gère la grille (lot RS, RS-D).
    // Miroir client : canEditPlanning (src/lib/access.ts).
    // Lot RS, RS-D : les admins et le gestionnaire du planning (`planning:<x>`, gerePlanning), sur toute la grille (Q5) ;
    // l'ancien côté (`plannings`, `remplitParRole`, référents, Orga) et la condition Régie par colonnes sont retirés.
    function peutEcrirePlanning(key) {
      return isAdmin() || gerePlanning(key);
    }

    match /plannings/{key} {
      allow read: if true;
      allow write: if false;

      match /dimanches/{date} {
        allow read: if true;
        allow create, update: if peutEcrirePlanning(key)
          && request.resource.data.date == date;
        // On vide les cases, on ne supprime pas un dimanche — sauf une date
        // posée par erreur, là seulement où les dates se choisissent (lot U2,
        // Q10). Miroir client : canRetirerDate (src/lib/access.ts).
        allow delete: if peutEcrirePlanning(key)
          && key in ['interfranco', 'intergroupe', 'campusMatin', 'campusSoir'];
      }

      // Historique nommé : lu par tout connecté, écrit par qui peut remplir,
      // sous son propre nom et sur ses propres entrées (patron de
      // setlists/{id}/history).
      match /history/{entryId} {
        allow read: if signedIn();
        allow create: if peutEcrirePlanning(key)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if peutEcrirePlanning(key)
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid;
        allow delete: if false;
      }
    }

    // Petit déj (lot U3, docs/spec-petit-dej.md). Lecture publique, comme plannings/*. Sa ligne : tout connecté ;
    // une ligne pour quelqu'un (uid vide), réécrire ou retirer : écrivains du planning Table et admins. Dimanche,
    // inscrit et auteur figés ; borne du passé côté client. Miroir : canGererPetitDej, canEditPetitDej (access.ts).
    match /petitDej/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.auteurUid == request.auth.uid
        && request.resource.data.dimanche.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 80
        && (request.resource.data.uid == request.auth.uid
            || (request.resource.data.uid == '' && peutEcrirePlanning('table')));
      allow update: if signedIn()
        && request.resource.data.dimanche == resource.data.dimanche
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.auteurUid == resource.data.auteurUid
        && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 80
        && (resource.data.uid == request.auth.uid || peutEcrirePlanning('table'));
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || peutEcrirePlanning('table'));
    }
  }
}
