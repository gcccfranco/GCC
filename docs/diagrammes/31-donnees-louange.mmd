  SETLISTS ||--o{ VERSIONS : "sous-collection versions"
  USERS ||--o{ VERSIONS : "une par personne"
  USERS ||--o{ ANNOTATIONS : "userId dans l'id"
  SETLISTS ||--o{ ANNOTATIONS : "setlistId dans l'id"
